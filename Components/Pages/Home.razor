<!-- ALL FILTERS MODAL DRAWER -->
@if (_showFilterDrawer)
{
    <div class="fixed inset-0 z-50 overflow-hidden bg-stone-900/60 backdrop-blur-sm flex justify-end animate-in fade-in duration-200">
        <div class="w-full max-w-md bg-white h-full shadow-2xl p-6 flex flex-col justify-between overflow-y-auto animate-in slide-in-from-right duration-300">
            <div class="space-y-6">
                <!-- Drawer Header -->
                <div class="flex items-center justify-between border-b border-stone-200 pb-4">
                    <div>
                        <h3 class="text-lg font-bold text-stone-900">Filters</h3>
                        <p class="text-xs text-stone-500">Refine destination experiences</p>
                    </div>
                    <button type="button"
                            @onclick="() => _showFilterDrawer = false"
                            class="w-8 h-8 rounded-full bg-stone-100 hover:bg-stone-200 flex items-center justify-center text-stone-600 transition">
                        ✕
                    </button>
                </div>

                <!-- Price Range Filter -->
                <div class="space-y-3">
                    <div class="flex items-center justify-between text-xs font-bold text-stone-800">
                        <span>Max Price per person</span>
                        <span class="text-[#B55B3A] font-bold">$@_maxPriceFilter</span>
                    </div>
                    <input type="range"
                           min="80"
                           max="400"
                           step="10"
                           @bind="_maxPriceFilter"
                           @bind:event="oninput"
                           class="w-full accent-[#B55B3A] cursor-pointer" />
                    <div class="flex justify-between text-[11px] text-stone-400">
                        <span>$80</span>
                        <span>$400+</span>
                    </div>
                </div>

                <!-- Categories Checkboxes -->
                <div class="space-y-2">
                    <span class="text-xs font-bold text-stone-800 block">Category</span>
                    <div class="grid grid-cols-2 gap-2">
                        @foreach (var cat in new[] { "Nature", "Culture", "Beach", "Eco" })
                        {
                            <button type="button"
                                    @onclick="() => ToggleCategory(cat)"
                                    class="px-3 py-2 rounded-xl border text-xs font-semibold text-left transition @(_selectedCategory == cat ? "border-[#B55B3A] bg-[#FDF2EC] text-[#B55B3A]" : "border-stone-200 text-stone-700 hover:bg-stone-50")">
                                @cat
                            </button>
                        }
                    </div>
                </div>

                <!-- Minimum Rating Filter -->
                <div class="space-y-2">
                    <span class="text-xs font-bold text-stone-800 block">Rating</span>
                    <div class="flex gap-2">
                        @foreach (var minR in new[] { (Label: "All", Value: 0.0), (Label: "4.9+ ★", Value: 4.9), (Label: "4.95+ ★", Value: 4.95) })
                        {
                            <button type="button"
                                    @onclick="() => _minRatingFilter = minR.Value"
                                    class="flex-1 py-1.5 rounded-xl border text-xs font-semibold text-center transition @(_minRatingFilter == minR.Value ? "border-[#B55B3A] bg-[#FDF2EC] text-[#B55B3A]" : "border-stone-200 text-stone-700 hover:bg-stone-50")">
                                @minR.Label
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Drawer Bottom Buttons -->
            <div class="pt-6 border-t border-stone-200 flex gap-3">
                <button type="button"
                        @onclick="ResetAllFilters"
                        class="flex-1 border border-stone-200 hover:bg-stone-100 text-stone-700 text-xs font-semibold py-3 rounded-xl transition">
                    Reset
                </button>
                <button type="button"
                        @onclick="() => _showFilterDrawer = false"
                        class="flex-1 bg-[#3E3430] hover:bg-[#322A26] text-white text-xs font-semibold py-3 rounded-xl transition shadow">
                    Apply Filters
                </button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    private string? _selectedCategory;
    private string _searchDestination = string.Empty;
    private string _sortBy = "recommended";
    private int _heroGuests = 2;
    private string _heroTravelDates = "12–14 Jun 2027";
    private HashSet<string> _favorites = new();

    private bool _showDestinationMenu = false;
    private bool _showDateMenu = false;
    private bool _showGuestMenu = false;
    private bool _showFilterDrawer = false;

    private int _maxPriceFilter = 500;
    private double _minRatingFilter = 0.0;

    private int _activeFilterCount =>
        (!string.IsNullOrWhiteSpace(_selectedCategory) ? 1 : 0) +
        (_maxPriceFilter < 500 ? 1 : 0) +
        (_minRatingFilter > 0 ? 1 : 0);

    private readonly string[] _popularDestinations = new[]
    {
        "Bali, Indonesia",
        "Kyoto, Japan",
        "Nusa Penida, Bali",
        "Dolomites, Italy"
    };

    private readonly string[] _availableDateOptions = new[]
    {
        "12–14 Jun 2027",
        "19–21 Jun 2027",
        "26–28 Jun 2027",
        "3–5 Jul 2027"
    };

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            _searchDestination = SearchQuery;
        }
    }

    private void ToggleDateMenu()
    {
        _showDateMenu = !_showDateMenu;
        _showGuestMenu = false;
        _showDestinationMenu = false;
    }

    private void ToggleGuestMenu()
    {
        _showGuestMenu = !_showGuestMenu;
        _showDateMenu = false;
        _showDestinationMenu = false;
    }

    private void SelectDate(string date)
    {
        _heroTravelDates = date;
        _showDateMenu = false;
        StateHasChanged();
    }

    private void SelectDestination(string destination)
    {
        _searchDestination = destination;
        _showDestinationMenu = false;
        StateHasChanged();
    }

    private void IncrementHeroGuests()
    {
        if (_heroGuests < 8) _heroGuests++;
    }

    private void DecrementHeroGuests()
    {
        if (_heroGuests > 1) _heroGuests--;
    }

    private void ToggleCategory(string category)
    {
        if (_selectedCategory == category)
            _selectedCategory = null;
        else
            _selectedCategory = category;

        StateHasChanged();
    }

    private void ResetAllFilters()
    {
        _selectedCategory = null;
        _searchDestination = string.Empty;
        _maxPriceFilter = 500;
        _minRatingFilter = 0.0;
        _showFilterDrawer = false;
        StateHasChanged();
    }

    private async Task FilterByDestination(string keyword)
    {
        _searchDestination = keyword;
        StateHasChanged();
        await ScrollToToursSection();
    }

    private void ToggleFavorite(string tourId)
    {
        if (_favorites.Contains(tourId))
            _favorites.Remove(tourId);
        else
            _favorites.Add(tourId);

        StateHasChanged();
    }

    private async Task HandleHeroExplore()
    {
        _showDateMenu = false;
        _showGuestMenu = false;
        _showDestinationMenu = false;
        StateHasChanged();
        await ScrollToToursSection();
    }

    private async Task ScrollToToursSection()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('tours-section')?.scrollIntoView({ behavior: 'smooth' })");
        }
        catch
        {
            // Fallback
        }
    }

    private string GetFilterPillClass(string category)
    {
        var isSelected = string.Equals(_selectedCategory, category, StringComparison.OrdinalIgnoreCase);
        return isSelected
            ? "inline-flex items-center gap-1.5 text-xs font-semibold text-white bg-[#B55B3A] border border-[#B55B3A] px-3.5 py-2 rounded-full transition-all shadow-md active:scale-95 cursor-pointer ring-2 ring-[#B55B3A]/30"
            : "inline-flex items-center gap-1.5 text-xs font-medium text-stone-700 bg-white border border-stone-200/90 hover:bg-stone-50 px-3.5 py-2 rounded-full transition-colors shadow-sm active:scale-95 cursor-pointer";
    }

    private IEnumerable<Tour> GetFilteredTours()
    {
        var tours = TourService.GetAllTours().AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_selectedCategory))
        {
            tours = tours.Where(t => string.Equals(t.Category, _selectedCategory, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_searchDestination))
        {
            tours = tours.Where(t =>
                t.Location.Contains(_searchDestination, StringComparison.OrdinalIgnoreCase) ||
                t.Country.Contains(_searchDestination, StringComparison.OrdinalIgnoreCase) ||
                t.Title.Contains(_searchDestination, StringComparison.OrdinalIgnoreCase));
        }

        if (_maxPriceFilter < 500)
        {
            tours = tours.Where(t => t.Price <= _maxPriceFilter);
        }

        if (_minRatingFilter > 0)
        {
            tours = tours.Where(t => t.Rating >= _minRatingFilter);
        }

        return _sortBy switch
        {
            "price-low" => tours.OrderBy(t => t.Price),
            "price-high" => tours.OrderByDescending(t => t.Price),
            "rating" => tours.OrderByDescending(t => t.Rating),
            _ => tours
        };
    }
}
