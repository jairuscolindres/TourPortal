@code {
    [Parameter]
    public string? Id { get; set; }

    private Tour? Tour { get; set; }
    private GuestBooking _bookingModel = new();
    private HashSet<int> _expandedDays = new() { 1 };
    private bool _showDateDropdown = false;
    private bool _showGalleryModal = false;
    private bool _isSubmitting = false;

    private readonly string[] _availableDates = new[]
    {
        "12–14 Jun 2027",
        "19–21 Jun 2027",
        "26–28 Jun 2027",
        "3–5 Jul 2027",
        "10–12 Jul 2027"
    };

    protected override void OnInitialized()
    {
        LoadTour();
    }

    protected override void OnParametersSet()
    {
        LoadTour();
    }

    private void LoadTour()
    {
        var targetId = string.IsNullOrWhiteSpace(Id) ? "tour-ubud-naturally" : Id;
        Tour = TourService.GetTourById(targetId) ?? TourService.GetAllTours().FirstOrDefault();

        if (Tour != null)
        {
            _bookingModel = new GuestBooking
            {
                TourId = Tour.Id,
                TourTitle = Tour.Title,
                TourImageUrl = Tour.ImageUrl,
                TourLocation = $"{Tour.Location}, {Tour.Country}",
                PricePerPerson = Tour.Price,
                TravelDates = Tour.AvailableDates,
                GuestCount = 2,
                LeadTravelerName = "Alex Morgan",
                Email = "alex.morgan@example.com",
                Phone = "+1 (415) 555-0138",
                TotalPaid = Tour.Price * 2
            };
        }
    }

    private void SelectBookingDate(string date)
    {
        _bookingModel.TravelDates = date;
        _showDateDropdown = false;
        StateHasChanged();
    }

    private void ToggleDay(int dayNumber)
    {
        if (_expandedDays.Contains(dayNumber))
            _expandedDays.Remove(dayNumber);
        else
            _expandedDays.Add(dayNumber);
        
        StateHasChanged();
    }

    private void IncrementGuests()
    {
        if (_bookingModel.GuestCount < 8)
        {
            _bookingModel.GuestCount++;
            StateHasChanged();
        }
    }

    private void DecrementGuests()
    {
        if (_bookingModel.GuestCount > 1)
        {
            _bookingModel.GuestCount--;
            StateHasChanged();
        }
    }

    private async Task HandleConfirmBooking()
    {
        if (Tour == null) return;

        _isSubmitting = true;
        StateHasChanged();

        if (string.IsNullOrWhiteSpace(_bookingModel.LeadTravelerName))
            _bookingModel.LeadTravelerName = "Alex Morgan";
        if (string.IsNullOrWhiteSpace(_bookingModel.Email))
            _bookingModel.Email = "alex.morgan@example.com";
        if (string.IsNullOrWhiteSpace(_bookingModel.Phone))
            _bookingModel.Phone = "+1 (415) 555-0138";

        _bookingModel.TourId = Tour.Id;
        _bookingModel.TourTitle = Tour.Title;
        _bookingModel.TourImageUrl = Tour.ImageUrl;
        _bookingModel.PricePerPerson = Tour.Price;
        _bookingModel.TotalPaid = Tour.Price * _bookingModel.GuestCount;

        await Task.Delay(200);

        // Save into scoped in-memory state service and navigate to /booking/pass
        BookingState.CreateBooking(_bookingModel);
        Navigation.NavigateTo("/booking/pass");
    }
}
