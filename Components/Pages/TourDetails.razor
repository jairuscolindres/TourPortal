@page "/tours/{Id}"
@rendermode InteractiveServer
@inject ITourDataService TourService
@inject BookingStateService BookingState
@inject NavigationManager Navigation

<PageTitle>@(Tour?.Title ?? "Tour Details") — TourPortal</PageTitle>

@if (Tour == null)
{
    <div class="max-w-7xl mx-auto px-4 py-16 text-center space-y-4">
        <h2 class="text-2xl font-serif text-stone-900">Destination Not Found</h2>
        <p class="text-sm text-stone-500">The requested tour could not be located in our curated catalog.</p>
        <a href="/" class="inline-block bg-[#3E3430] text-white text-xs font-semibold px-5 py-2.5 rounded-xl">Return to Explore</a>
    </div>
}
else
{
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
        <!-- BREADCRUMBS -->
        <nav class="flex items-center gap-2 text-xs text-stone-400">
            <a href="/" class="hover:text-stone-700 transition-colors">Explore</a>
            <span>&gt;</span>
            <a href="/" class="hover:text-stone-700 transition-colors">@Tour.Country</a>
            <span>&gt;</span>
            <span class="text-stone-700 font-semibold truncate">@Tour.Title</span>
        </nav>

        <!-- HERO PHOTO GALLERY (2/3 + 1/3 ASYMMETRIC GRID) -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-3.5 rounded-2xl overflow-hidden">
            <!-- Main Hero Image (2 columns) -->
            <div class="lg:col-span-2 relative h-[320px] sm:h-[400px] lg:h-[460px] rounded-2xl overflow-hidden bg-stone-100 group">
                <img src="@Tour.ImageUrl"
                     alt="@Tour.Title"
                     class="w-full h-full object-cover object-center group-hover:scale-102 transition-transform duration-700" />
                <div class="absolute bottom-4 left-4 bg-stone-950/70 backdrop-blur-md text-white text-xs px-3.5 py-1.5 rounded-full flex items-center gap-1.5 shadow-md">
                    <svg class="w-3.5 h-3.5 text-[#EEB7A2] stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                    </svg>
                    <span>@Tour.CoverCaption</span>
                </div>
            </div>

            <!-- Two Stacked Thumbnail Images (1 column) -->
            <div class="hidden lg:grid grid-rows-2 gap-3.5 h-[460px]">
                <!-- Top Thumbnail -->
                <div class="relative rounded-2xl overflow-hidden bg-stone-100 group cursor-pointer"
                     @onclick="() => _showGalleryModal = true">
                    <img src="@(Tour.GalleryImages.Count > 1 ? Tour.GalleryImages[1] : Tour.ImageUrl)"
                         alt="Experience gallery photo 1"
                         class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500" />
                </div>

                <!-- Bottom Thumbnail with Overlay Button -->
                <div class="relative rounded-2xl overflow-hidden bg-stone-100 group cursor-pointer"
                     @onclick="() => _showGalleryModal = true">
                    <img src="@(Tour.GalleryImages.Count > 2 ? Tour.GalleryImages[2] : Tour.ImageUrl)"
                         alt="Experience gallery photo 2"
                         class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500" />
                    
                    <button type="button"
                            @onclick="() => _showGalleryModal = true"
                            @onclick:stopPropagation="true"
                            class="absolute bottom-4 right-4 bg-white/95 hover:bg-white text-stone-800 text-xs font-semibold px-3.5 py-2 rounded-xl shadow-lg flex items-center gap-1.5 transition-all active:scale-95 cursor-pointer">
                        <span>View all 12 photos</span>
                        <svg class="w-3.5 h-3.5 stroke-current fill-none text-stone-600" viewBox="0 0 24 24" stroke-width="2">
                            <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                            <circle cx="9" cy="9" r="2" />
                            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                        </svg>
                    </button>
                </div>
            </div>
        </section>

        <!-- MAIN SPLIT LAYOUT: CONTENT (65%) & STICKY BOOKING FORM (35%) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
            <!-- LEFT COLUMN: TOUR DETAILS (65% -> 8 cols) -->
            <div class="lg:col-span-7 xl:col-span-8 space-y-10">
                <!-- Header Info -->
                <div class="space-y-3">
                    <div class="flex items-center gap-2 text-xs font-bold text-[#B55B3A] tracking-wider uppercase">
                        <span>@Tour.SubCategory</span>
                        <span class="text-stone-300">/</span>
                        <span class="text-stone-500">@Tour.Collection</span>
                    </div>

                    <h1 class="text-3xl sm:text-4xl md:text-5xl font-medium text-stone-900 font-serif tracking-tight">
                        @Tour.Title
                    </h1>

                    <!-- Meta Ratings Row -->
                    <div class="flex items-center flex-wrap gap-4 text-xs sm:text-sm text-stone-600 pt-1">
                        <span class="flex items-center gap-1.5 font-semibold text-stone-900">
                            <svg class="w-4 h-4 text-amber-500 fill-amber-500" viewBox="0 0 24 24">
                                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                            </svg>
                            <span>@Tour.Rating.ToString("0.00")</span>
                            <span class="font-normal text-stone-500">(@Tour.ReviewCount reviews)</span>
                        </span>

                        <span class="text-stone-300">•</span>

                        <span class="flex items-center gap-1 font-medium text-stone-700">
                            <svg class="w-4 h-4 text-[#B55B3A] stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                            </svg>
                            <span>@Tour.Location, @Tour.Country</span>
                        </span>

                        <span class="text-stone-300">•</span>

                        <span class="flex items-center gap-1 text-stone-700 font-medium">
                            <svg class="w-4 h-4 text-[#B55B3A] stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <span>@Tour.Duration</span>
                        </span>
                    </div>

                    <!-- Description -->
                    <p class="text-stone-600 text-sm sm:text-base leading-relaxed pt-2">
                        @Tour.Description
                    </p>
                </div>

                <!-- Feature Highlight Pills Banner (Warm Sand Background) -->
                <div class="bg-[#FAF4EE] border border-[#EFE4D8] rounded-2xl p-4 flex flex-wrap items-center justify-between gap-4 text-xs font-semibold text-[#8B4513]">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-[#B55B3A] stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                        </svg>
                        <span>@Tour.GroupSize</span>
                    </div>

                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-[#B55B3A] stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
                        </svg>
                        <span>@Tour.GuideInfo</span>
                    </div>

                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-[#B55B3A] stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.516 0c.85.493 1.508 1.333 1.508 2.316V18" />
                        </svg>
                        <span>@Tour.LeaderInfo</span>
                    </div>
                </div>

                <!-- SECTION: A LITTLE MORE, ALL INCLUDED -->
                <div class="space-y-4 pt-2">
                    <h2 class="text-2xl font-medium text-stone-900 font-serif tracking-tight">
                        A little more, all included.
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-stone-700">
                        @foreach (var inclusion in Tour.Inclusions)
                        {
                            <div class="flex items-start gap-2.5">
                                <svg class="w-4 h-4 text-[#B55B3A] stroke-current fill-none mt-0.5 shrink-0" viewBox="0 0 24 24" stroke-width="2.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                                </svg>
                                <span>@inclusion</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- SECTION: THREE DAYS, A DIFFERENT PACE (CLEAN MINIMAL ACCORDION MATCHING FIGMA) -->
                <div class="space-y-4 pt-4">
                    <div class="flex items-center justify-between border-b border-stone-200 pb-3">
                        <h2 class="text-2xl font-medium text-stone-900 font-serif tracking-tight">
                            Three days, a different pace.
                        </h2>
                        <span class="text-xs text-stone-500 font-medium">@_bookingModel.TravelDates</span>
                    </div>

                    <div class="space-y-3">
                        @foreach (var day in Tour.ItineraryDays)
                        {
                            var isOpen = _expandedDays.Contains(day.DayNumber);

                            <div class="border border-stone-200 rounded-2xl overflow-hidden bg-white shadow-sm transition-all">
                                <!-- Day Accordion Header Button -->
                                <button type="button"
                                        @onclick="() => ToggleDay(day.DayNumber)"
                                        class="w-full px-5 py-4 flex items-center justify-between text-left hover:bg-stone-50 transition-colors cursor-pointer">
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-bold uppercase tracking-wider text-[#B55B3A] bg-[#FDF2EC] px-2.5 py-1 rounded-md">
                                            Day @day.DayNumber
                                        </span>
                                        <span class="text-sm sm:text-base font-bold text-stone-900">
                                            @day.Title
                                        </span>
                                    </div>

                                    <svg class="w-5 h-5 text-stone-400 transform transition-transform duration-200 @(isOpen ? "rotate-180 text-[#B55B3A]" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                                    </svg>
                                </button>

                                <!-- Day Content (Clean, Minimal Time Slots with Terracotta Time) -->
                                @if (isOpen)
                                {
                                    <div class="px-5 pb-3 pt-1 border-t border-stone-100">
                                        @foreach (var item in day.Items)
                                        {
                                            <div class="py-3 border-b border-stone-100 last:border-b-0 flex items-center justify-between gap-4 text-xs sm:text-sm">
                                                <span class="font-semibold text-[#B55B3A] w-16 shrink-0 font-mono">
                                                    @item.TimeRange.Split('–')[0].Trim()
                                                </span>
                                                <span class="font-medium text-stone-800 flex-1">
                                                    @item.Title
                                                </span>
                                                <span class="text-xs text-stone-500 font-normal shrink-0 text-right">
                                                    @item.Duration
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: STICKY BOOKING SIDEBAR (35% -> 4 or 5 cols) -->
            <div class="lg:col-span-5 xl:col-span-4 sticky top-28 space-y-4">
                <div class="bg-white rounded-3xl border border-stone-200 p-6 sm:p-7 shadow-xl shadow-stone-200/50 space-y-6">
                    <!-- Price Header & Available Badge -->
                    <div class="flex items-center justify-between pb-4 border-b border-stone-100">
                        <div>
                            <span class="text-3xl font-bold text-stone-900">$@Tour.Price</span>
                            <span class="text-xs text-stone-500 font-normal"> / person</span>
                        </div>
                        <span class="bg-[#FDF2EC] text-[#B55B3A] text-xs font-semibold px-3 py-1 rounded-full border border-[#F6D7C9]">
                            Available
                        </span>
                    </div>

                    <!-- Travel Dates Field (Interactive Popover) -->
                    <div class="space-y-1.5 relative">
                        <label class="block text-xs font-semibold text-stone-700">Travel dates</label>
                        <div @onclick="() => _showDateDropdown = !_showDateDropdown"
                             class="w-full border border-stone-200 rounded-xl px-3.5 py-3 flex items-center justify-between text-xs sm:text-sm font-medium text-stone-800 bg-stone-50/50 hover:bg-stone-100 transition-colors cursor-pointer select-none">
                            <div class="flex items-center gap-2.5">
                                <svg class="w-4 h-4 text-[#B55B3A] stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
                                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                                    <line x1="16" x2="16" y1="2" y2="6" />
                                    <line x1="8" x2="8" y1="2" y2="6" />
                                    <line x1="3" x2="21" y1="10" y2="10" />
                                </svg>
                                <span>@_bookingModel.TravelDates</span>
                            </div>
                            <svg class="w-4 h-4 text-stone-400 stroke-current fill-none transform transition-transform @(_showDateDropdown ? "rotate-180" : "")" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                            </svg>
                        </div>

                        <!-- Date Selection Dropdown -->
                        @if (_showDateDropdown)
                        {
                            <div class="absolute left-0 top-full mt-2 w-full bg-white rounded-2xl shadow-2xl border border-stone-200 py-2 z-50 animate-in fade-in slide-in-from-top-1">
                                <div class="px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-stone-400">Select Departure</div>
                                @foreach (var d in _availableDates)
                                {
                                    <button type="button"
                                            @onclick="() => SelectBookingDate(d)"
                                            class="w-full text-left px-3.5 py-2.5 text-xs font-medium text-stone-700 hover:bg-[#FAF4EE] hover:text-[#B55B3A] flex items-center justify-between transition-colors @(_bookingModel.TravelDates == d ? "text-[#B55B3A] font-bold bg-[#FDF2EC]" : "")">
                                        <span>@d</span>
                                        @if (_bookingModel.TravelDates == d)
                                        {
                                            <span class="text-[10px] text-[#B55B3A] font-semibold bg-[#FBECE5] px-2 py-0.5 rounded-full">Selected</span>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <!-- Guests Stepper (Interactive) -->
                    <div class="flex items-center justify-between pt-1">
                        <div>
                            <div class="text-xs font-semibold text-stone-800">Guests</div>
                            <div class="text-[11px] text-stone-400">Adults · Ages 12+</div>
                        </div>

                        <div class="flex items-center gap-3">
                            <button type="button"
                                    @onclick="DecrementGuests"
                                    disabled="@(_bookingModel.GuestCount <= 1)"
                                    class="w-8 h-8 rounded-lg border border-stone-200 flex items-center justify-center text-stone-600 hover:bg-stone-100 disabled:opacity-40 disabled:cursor-not-allowed transition-colors text-base font-semibold active:scale-95 cursor-pointer">
                                –
                            </button>
                            <span class="w-4 text-center text-sm font-bold text-stone-900">@_bookingModel.GuestCount</span>
                            <button type="button"
                                    @onclick="IncrementGuests"
                                    disabled="@(_bookingModel.GuestCount >= 8)"
                                    class="w-8 h-8 rounded-lg border border-stone-200 flex items-center justify-center text-stone-600 hover:bg-stone-100 disabled:opacity-40 disabled:cursor-not-allowed transition-colors text-base font-semibold active:scale-95 cursor-pointer">
                                +
                            </button>
                        </div>
                    </div>

                    <!-- Guest Details EditForm -->
                    <div class="space-y-4 pt-3 border-t border-stone-100">
                        <div>
                            <h3 class="text-sm font-bold text-stone-900">Your details. No account needed.</h3>
                            <p class="text-xs text-stone-500">We'll send your tour pass straight to your inbox.</p>
                        </div>

                        <div class="space-y-3">
                            <div>
                                <label class="block text-[11px] font-semibold text-stone-700 mb-1">Full name</label>
                                <input type="text"
                                       @bind="_bookingModel.LeadTravelerName"
                                       @bind:event="oninput"
                                       placeholder="Alex Morgan"
                                       class="w-full bg-[#FAF8F5] border border-stone-200 rounded-xl px-3.5 py-2.5 text-xs text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-[#B55B3A]/20 focus:border-[#B55B3A] transition" />
                            </div>

                            <div>
                                <label class="block text-[11px] font-semibold text-stone-700 mb-1">Email address</label>
                                <input type="email"
                                       @bind="_bookingModel.Email"
                                       @bind:event="oninput"
                                       placeholder="alex.morgan@example.com"
                                       class="w-full bg-[#FAF8F5] border border-stone-200 rounded-xl px-3.5 py-2.5 text-xs text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-[#B55B3A]/20 focus:border-[#B55B3A] transition" />
                            </div>

                            <div>
                                <label class="block text-[11px] font-semibold text-stone-700 mb-1">Phone number</label>
                                <input type="tel"
                                       @bind="_bookingModel.Phone"
                                       @bind:event="oninput"
                                       placeholder="+1 (415) 555-0138"
                                       class="w-full bg-[#FAF8F5] border border-stone-200 rounded-xl px-3.5 py-2.5 text-xs text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-[#B55B3A]/20 focus:border-[#B55B3A] transition" />
                            </div>
                        </div>
                    </div>

                    <!-- Price Breakdown Summary -->
                    <div class="space-y-2 pt-2 border-t border-stone-100 text-xs text-stone-600">
                        <div class="flex items-center justify-between">
                            <span>$@Tour.Price × @_bookingModel.GuestCount guests</span>
                            <span class="font-semibold text-stone-900">$@(_bookingModel.GuestCount * Tour.Price)</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span>Taxes &amp; fees</span>
                            <span class="text-[#B55B3A] font-medium">Included</span>
                        </div>

                        <div class="pt-3 border-t border-stone-100 flex items-center justify-between">
                            <span class="text-sm font-bold text-stone-900">Total <span class="text-[11px] font-normal text-stone-500">(USD)</span></span>
                            <span class="text-2xl font-bold text-stone-900">$@(_bookingModel.GuestCount * Tour.Price)</span>
                        </div>
                    </div>

                    <!-- Confirm Action Button (Warm Terracotta Color matching new design) -->
                    <button type="button"
                            @onclick="HandleConfirmBooking"
                            disabled="@_isSubmitting"
                            class="w-full bg-[#B55B3A] hover:bg-[#A24E30] text-white font-semibold text-sm py-3.5 px-4 rounded-xl shadow-md shadow-[#B55B3A]/20 flex items-center justify-center gap-2 transition-all active:scale-98 cursor-pointer disabled:opacity-75">
                        @if (_isSubmitting)
                        {
                            <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span>Generating Pass...</span>
                        }
                        else
                        {
                            <span>Confirm &amp; Generate Pass</span>
                            <svg class="w-4 h-4 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2.5">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        }
                    </button>

                    <p class="text-[11px] text-stone-400 text-center leading-normal">
                        By confirming, you agree to our booking terms. Your digital pass will be generated instantly.
                    </p>
                </div>
            </div>
        </div>
    </div>
}

<!-- PHOTO GALLERY LIGHTBOX MODAL -->
@if (_showGalleryModal && Tour != null)
{
    <div class="fixed inset-0 z-50 overflow-hidden bg-stone-950/80 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 animate-in fade-in duration-200"
         @onclick="() => _showGalleryModal = false">
        <div class="bg-white rounded-3xl max-w-4xl w-full max-h-[90vh] overflow-hidden flex flex-col shadow-2xl animate-in zoom-in-95 duration-200"
             @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="p-4 sm:p-6 border-b border-stone-200 flex items-center justify-between">
                <div>
                    <h3 class="text-xl font-bold font-serif text-stone-900">@Tour.Title Gallery</h3>
                    <p class="text-xs text-stone-500">@Tour.Location, @Tour.Country</p>
                </div>
                <button type="button"
                        @onclick="() => _showGalleryModal = false"
                        class="w-9 h-9 rounded-full bg-stone-100 hover:bg-stone-200 flex items-center justify-center text-stone-700 transition">
                    ✕
                </button>
            </div>

            <!-- Modal Body (Gallery Grid) -->
            <div class="p-6 overflow-y-auto space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    @foreach (var img in Tour.GalleryImages)
                    {
                        <div class="rounded-2xl overflow-hidden aspect-[4/3] bg-stone-100 shadow-sm">
